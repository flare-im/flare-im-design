{
  "name": "@flare-im/tokens",
  "version": "1.0.5",
  "description": "Flare IM design tokens — one neutral source of visual truth, generated per platform (L3 of the Flare IM UI Kit).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens.json",
    "build.mjs",
    "theme.js",
    "theme.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json",
    "./theme": {
      "types": "./theme.d.ts",
      "default": "./theme.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "keywords": [
    "flare",
    "im",
    "design-tokens",
    "theme",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flare-im/flare-im-design.git",
    "directory": "tokens"
  }
}
