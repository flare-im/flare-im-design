{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@flare-im/sdk/web": ["../../flare-im-core-client-sdk/packages/flare-core-typescript-sdk/src/adapters/web/index.ts"],
      "@flare-im/sdk/*": ["../../flare-im-core-client-sdk/packages/flare-core-typescript-sdk/src/*"],
      "@flare-im/sdk": ["../../flare-im-core-client-sdk/packages/flare-core-typescript-sdk/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/app/shared/testing/**"]
}
