{
  "name": "@flare-im/vue-ui",
  "version": "1.0.5",
  "description": "Flare IM UI Kit — Vue 3 + Naive UI component library for chat (conversation list, message list/bubble, composer, media, business cards). L1 web implementation, driven by core observable views + @flare-im/tokens.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/flare-im/flare-im-design",
  "repository": {
    "type": "git",
    "url": "https://github.com/flare-im/flare-im-design.git",
    "directory": "vue-im-ui"
  },
  "bugs": "https://github.com/flare-im/flare-im-design/issues",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "files": [
    "src",
    "README.md",
    "!src/assets/**/*.webp",
    "!src/assets/**/*.png",
    "!src/assets/**/*.jpg",
    "!src/assets/**/*.gif",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/__tests__/**"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/design-system/theme/index.ts",
    "./i18n": "./src/shared/i18n/index.ts",
    "./contracts": "./src/shared/contracts/index.ts",
    "./composables": "./src/composables/index.ts",
    "./components": "./src/components/index.ts",
    "./utils": "./src/utils/index.ts",
    "./style.css": "./src/design-system/styles/index.css",
    "./sdk-lab": "./src/app/components/FlareSdkLabPanel.vue",
    "./app": "./src/app/index.ts",
    "./app/components/*": "./src/app/components/*",
    "./app/style.css": "./src/app/styles/index.css",
    "./icon-glyphs": "./src/shared/icon-glyphs.ts"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "@flare-im/tokens": "^1.0.5",
    "markdown-it": "^14.2.0",
    "lucide-vue-next": "0.577.0"
  },
  "peerDependencies": {
    "@flare-im/sdk": "*",
    "naive-ui": "^2.44.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@flare-im/sdk": {
      "optional": true
    }
  },
  "keywords": [
    "flare",
    "im",
    "chat",
    "vue",
    "vue3",
    "naive-ui",
    "component-library",
    "instant-messaging",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:browser-download": "node scripts/browser-download-regression.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "gen:icons": "node scripts/gen-icon-shim.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.0",
    "@vicons/ionicons5": "^0.12.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "esbuild": "^0.25.12",
    "@flare-im/sdk": "file:../../flare-im-core-client-sdk/packages/flare-core-typescript-sdk",
    "markdown-it": "^14.2.0",
    "naive-ui": "^2.44.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.1.10"
  }
}
