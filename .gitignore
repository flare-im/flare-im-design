# dependencies
**/node_modules/

# site build output — NOTE: tokens/dist is a committed generated artifact the
# site + packages consume, so it is intentionally NOT ignored here.
site/.vitepress/dist/
site/.vitepress/cache/

# generated download archives (regenerate via site/scripts/pack-downloads.sh)
site/public/downloads/

# Flutter
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/*.iml

# Swift / iOS
**/.build/
**/DerivedData/
**/Pods/
**/*.xcuserstate

# build outputs (Flutter build/, Android build/)
**/build/
**/.gradle/
android-im-ui/local.properties
**/*.hprof

# macOS / editors / logs
.DS_Store
*.log

# ── iOS 资源镜像(构建期由 sync-resources.sh 生成,勿入库)──────
# SwiftPM 不跟随符号链接,所以 iOS 包需要一份真实副本。但把它提交进 git
# 意味着同一份 67MB 资源在仓库里存两遍(assets/ 一份 + 这里一份 = 134MB),
# 已实测导致完整 clone 连续失败 → iOS SPM 反而因此装不上。
# 发包前跑 ios-im-ui/sync-resources.sh 生成即可。
ios-im-ui/Sources/FlareIMUI/Resources/emoji-sticker/

# ── 表情/贴纸二进制(不入库,见 assets/emoji-sticker/fetch-assets.sh)────
# 250 个动画 webp 共 67MB。曾提交在 git 里(iOS 镜像再存一份=134MB),
# 实测导致完整 clone 连续失败 → iOS SPM 只能完整克隆,因此装不上。
# 已用 git filter-repo 清出历史,仓库 80MB → 2.0MB。
# manifest.json / emoji-locales.json 是文本契约,仍在版本控制内。
assets/emoji-sticker/**/*.webp
