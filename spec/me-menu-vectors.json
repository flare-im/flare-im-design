          },
          {
            "kind": "builtin",
            "id": "settings",
            "icon": "settings",
            "order": 2147483647,
            "target": {
              "route": "settings"
            }
          }
        ],
        "complete": true
      },
      "summaries": {
        "plugin:flare.redpacket.wallet-entry": "¥12.00"
      },
      "expect": [
        {
          "items": [
            {
              "key": "moments",
              "label": "圈子",
              "icon": "moments"
            },
            {
              "key": "reports",
              "label": "我的举报",
              "icon": "report"
            },
            {
              "key": "invite",
              "label": "我的邀请",
              "icon": "person-add"
            },
