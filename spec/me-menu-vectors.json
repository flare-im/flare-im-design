{
  "schemaVersion": 1,
  "note": "flareMeMenuSections(menu, labels, summaries): the social SDK's features.meMenu result as settings sections. `menu` is the SDK JSON as given; `labels` overrides the built-in items' copy by id; `summaries` maps item ids — built-in or plugin — to their subtitle (a plugin item's meMenuSummary text, a built-in item's host copy). Expected items are {key, label, icon, detail?}; every item is a navigation row. `locale` picks the kit copy (zh: the Chinese defaults, en: strings/en.json).",
  "rules": {
    "order": "The SDK orders the menu (built-ins, then plugin entries, settings last); the kit never re-sorts by `order`. Section one holds every item but settings, in the given order; settings alone is section two, last. An empty section is left out.",
    "builtin": "A built-in item's label is labels[id], else the kit copy meMenuMoments / meMenuReports / meMenuInvite / meMenuSettings. A built-in id the kit does not know is dropped. detail is summaries[id] trimmed when not empty: the host's subtitle for its own page (what 我的邀请 holds), by the item id.",
    "plugin": "A plugin item's label is its title trimmed, else meMenuPluginFallback. detail is summaries[id] trimmed when not empty (its meMenuSummary).",
    "icon": "icon = flareIconNameOrFallback(item.icon): a registry name (trimmed) as is; any other name, or none, → `plugin` (the shared fallback, iconFallback).",
    "drop": "An item whose kind is neither builtin nor plugin is dropped; of two items with one id the first is kept."
  },
  "copy": {
    "zh": {
      "moments": "圈子",
      "reports": "我的举报",
      "invite": "我的邀请",
      "settings": "设置",
      "pluginFallback": "插件"
    },
    "en": {
      "moments": "Moments",
      "reports": "My reports",
      "invite": "My invites",
      "settings": "Settings",
      "pluginFallback": "Plugin"
    }
  },
