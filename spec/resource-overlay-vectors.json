  "fold": [
    {
      "name": "the later pack wins a key, the earlier one keeps the rest",
      "locale": "zh-CN",
      "builtIn": {
        "a": "一",
        "b": "二"
      },
      "known": [
        "primary"
      ],
      "packs": [
        {
          "id": "p1",
