            "at": 100,
            "op": "started",
            "conversationId": "c1",
            "userId": "u2"
          },
          {
            "at": 200,
            "op": "started",
            "conversationId": "c1",
            "userId": "u1"
          }
        ],
        "endAt": 200,
        "expect": [
          {
            "at": 0,
            "typers": [
              "u1"
            ]
          },
          {
            "at": 100,
            "typers": [
              "u1",
              "u2"
            ]
          }
