            "at": 0,
            "op": "started",
            "conversationId": "c1",
            "userId": "u1"
          },
          {
            "at": 3000,
            "op": "started",
            "conversationId": "c1",
            "userId": "u1"
          }
        ],
        "endAt": 10000,
        "expect": [
          {
            "at": 0,
            "typers": [
