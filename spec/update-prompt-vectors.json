      "expect": { "phase": "ready", "forced": true, "dismissible": false, "live": "assertive", "title": "ready", "message": "ready", "actions": ["restart", "continueReadOnly"], "notes": false, "progress": null }
    },
    {
      "name": "installing cannot be left",
      "input": { "form": "sheet", "state": "installing" },
      "expect": { "phase": "installing", "forced": false, "dismissible": false, "live": "polite", "title": "installing", "message": null, "actions": [], "notes": false, "progress": { "value": null, "percent": null } }
    },
    {
      "name": "a failure that can be retried",
      "input": { "form": "sheet", "state": "failed", "errorCode": "update.downloadFailed" },
      "expect": { "phase": "failed", "forced": false, "dismissible": true, "live": "polite", "title": "failed", "message": "downloadFailed", "actions": ["retry", "fallback", "later"], "notes": false, "progress": null }
    },
    {
      "name": "a failure that cannot be retried leaves the fallback first",
      "input": { "form": "modal", "state": "failed", "errorCode": "update.signatureMismatch", "retryable": false },
      "expect": { "phase": "failed", "forced": false, "dismissible": true, "live": "polite", "title": "failed", "message": "signatureMismatch", "actions": ["fallback", "later"], "notes": false, "progress": null }
    },
    {
      "name": "a forced failure has no later",
      "input": { "form": "fullscreen", "mandatory": true, "state": "failed", "errorCode": "update.hashMismatch" },
      "expect": { "phase": "failed", "forced": true, "dismissible": false, "live": "assertive", "title": "failed", "message": "hashMismatch", "actions": ["retry", "fallback"], "notes": false, "progress": null }
    },
    {
      "name": "a forced failure keeps read-only when allowed",
      "input": { "form": "modal", "mandatory": true, "state": "failed", "errorCode": "update.installFailed", "canContinueReadOnly": true },
      "expect": { "phase": "failed", "forced": true, "dismissible": false, "live": "assertive", "title": "failed", "message": "installFailed", "actions": ["retry", "fallback", "continueReadOnly"], "notes": false, "progress": null }
    },
