      "expect": { "phase": "failed", "forced": false, "dismissible": true, "live": "polite", "title": "failed", "message": "insufficientSpace", "actions": ["retry", "fallback", "later"], "notes": false, "progress": null }
    },
    {
      "name": "the failed state with no code reads as unknown",
      "input": { "form": "modal", "state": "failed" },
      "expect": { "phase": "failed", "forced": false, "dismissible": true, "live": "polite", "title": "failed", "message": "unknown", "actions": ["retry", "fallback", "later"], "notes": false, "progress": null }
    },
    {
      "name": "a forced offer says the reason in place of its fixed words",
