    {
      "name": "a failure keeps its own words over the reason",
      "input": { "form": "fullscreen", "mandatory": true, "state": "failed", "errorCode": "update.hashMismatch", "reason": "This build has been withdrawn." },
      "expect": { "phase": "failed", "forced": true, "dismissible": false, "live": "assertive", "title": "failed", "message": "hashMismatch", "actions": ["retry", "fallback"], "notes": false, "progress": null }
    }
  ]
}
