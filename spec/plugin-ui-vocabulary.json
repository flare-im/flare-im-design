{
  "$comment": "The plugin UI vocabulary the design kits render (flare-plugin-protocol UiVocabulary). Hosts pass each kit's PLUGIN_UI_VOCABULARY to the engine through plugin.set_host_profile (kitVocabulary); the engine intersects it with its own vocabulary and the host's native allowlist. `vocabulary` is what every kit renders; `kits.<kit>.omit` lists names a kit does not render yet, so it never reports them. Generated into each kit by spec/build-plugin-ui-vocabulary.mjs; `--check` fails when a generated file is out of date. Add a name here only once every kit not omitting it renders it.",
  "vocabulary": {
    "version": 2,
    "blocks": [
      "text",
      "fields",
      "choices",
      "entries",
      "people",
      "status",
      "progress",
      "time",
      "divider",
      "note",
      "rows",
      "protected-media",
      "section",
      "stats",
      "chart",
      "image",
      "qr",
      "hero",
      "steps",
      "banner",
      "timeline"
    ],
    "inputs": [
      "text",
      "password",
      "textarea",
      "number",
      "toggle",
      "select",
      "datetime",
      "options",
      "members",
      "file",
      "money",
      "image",
      "document"
    ],
    "formats": [
      "money",
      "enum",
      "person",
      "reference",
      "time",
      "percent",
      "duration",
      "count",
      "bytes"
    ],
    "actions": ["operation", "page", "native"],
    "native": ["selectImage", "selectFile", "camera", "microphone", "clipboardWrite"],
    "renderers": ["redPacket.card", "redPacket.pay", "payment.confirm"],
    "kinds": [
      "message-content",
      "message-action",
      "conversation-menu",
      "composer-action",
      "page",
      "account-entry"
    ]
  },
  "kits": {
    "vue": { "omit": {} },
    "flutter": { "omit": { "blocks": ["protected-media"] } },
    "android": { "omit": { "blocks": ["protected-media"] } },
    "ios": { "omit": { "blocks": ["protected-media"] } }
  }
}
