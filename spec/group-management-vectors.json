{
  "$comment": "Shared table for the group management entries on four platforms (GroupDetail, GroupPermissionMatrix, MemberRoleSheet). The kit decides nothing about who may manage what: the host passes what its permission source answered — the viewer's capabilities (canManageInfo, canManageJoinSettings, canManageJoinRequests, canInvite, canDissolve; the social SDK's memberCapabilities) and, per member, the member actions (canRemove, canMute, canChangeRole, canTransferOwner; the social SDK's memberActions) — and the kit maps each answer to the entries it names. entries: capabilities → groupManagementEntries, in display order; without dissolve the page offers leaving. memberActions: a member's role and muted state plus its actions → memberRoleActions (label and danger group). detailSheet: GroupDetail's member sheet for memberId → groupDetailMemberActions (role from ownerId / adminIds, muted from mutedIds, actions from memberActions; no entry opens no sheet). The permission matrix row of a key is editable exactly when entries offers that key. Each platform's test runs every vector by id.",
  "entryOrder": ["editName", "editAnnouncement", "discoverable", "joinPolicy", "joinRequests", "muteAll", "inviteLink", "onlyAdminCanAtAll", "onlyAdminCanPin", "shareCardPermission", "inviteMembers", "dissolve"],
  "entries": [
    {
      "id": "e.none",
      "capabilities": {},
      "expected": []
    },
    {
      "id": "e.allFalse",
      "capabilities": { "canManageInfo": false, "canManageJoinSettings": false, "canManageJoinRequests": false, "canInvite": false, "canDissolve": false },
      "expected": []
    },
    {
      "id": "e.owner",
      "capabilities": { "canManageInfo": true, "canManageJoinSettings": true, "canManageJoinRequests": true, "canInvite": true, "canDissolve": true },
      "expected": ["editName", "editAnnouncement", "discoverable", "joinPolicy", "joinRequests", "muteAll", "inviteLink", "onlyAdminCanAtAll", "onlyAdminCanPin", "shareCardPermission", "inviteMembers", "dissolve"]
    },
    {
      "id": "e.fullAdmin",
      "capabilities": { "canManageInfo": true, "canManageJoinRequests": true, "canInvite": true },
