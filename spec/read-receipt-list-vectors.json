          "expect": { "state": "ready", "read": { "people": ["r1"], "nextCursor": "rc1" }, "unread": { "people": ["u1"], "nextCursor": "uc1" }, "loadingMore": "read", "loadMoreFailed": null }
        },
        {
          "do": "loadMore:unread",
