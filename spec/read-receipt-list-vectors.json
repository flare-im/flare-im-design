        }
      ]
    },
    {
      "id": "next-page-not-offered-ends-its-column",
      "platforms": ["vue", "compose", "flutter", "ios"],
      "steps": [
        {
          "do": "open",
          "asks": [["read", null], ["unread", null]],
          "answers": { "read": { "people": ["r1"], "nextCursor": "rc1" }, "unread": { "people": [] } },
          "expect": { "state": "ready", "read": { "people": ["r1"], "nextCursor": "rc1" }, "unread": { "people": [] }, "loadingMore": null, "loadMoreFailed": null }
        },
