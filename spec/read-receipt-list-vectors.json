          "expect": { "state": "ready", "read": { "people": ["r1"], "nextCursor": "rc1" }, "unread": { "people": ["u1"], "nextCursor": "uc1" }, "loadingMore": "unread", "loadMoreFailed": null }
        },
        { "do": "loadMore:read", "asks": [], "expect": { "state": "ready", "read": { "people": ["r1"], "nextCursor": "rc1" }, "unread": { "people": ["u1"], "nextCursor": "uc1" }, "loadingMore": "unread", "loadMoreFailed": null } },
        {
          "do": "settle:read",
          "answer": { "people": ["r2"] },
          "expect": { "state": "ready", "read": { "people": ["r1", "r2"] }, "unread": { "people": ["u1"], "nextCursor": "uc1" }, "loadingMore": "unread", "loadMoreFailed": null }
        },
        {
