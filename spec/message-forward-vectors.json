          "title": "",
          "items": [
            {
              "sourceSenderName": "林夏",
              "sourceMessageTimeMs": 1761100000000,
              "plainText": "今晚七点见"
            }
          ]
        }
      },
      "expect": {
        "layout": "single",
        "text": {
          "zh": "今晚七点见",
          "en": "今晚七点见"
        }
      }
    },
