  },
  "documentCompression": {
    "$comment": "The order the kit tries (longest edge in px, JPEG quality) until the photo fits maxBytes; none fits: the photo is too large. The output is always image/jpeg, re-encoded from pixels, so no EXIF, GPS or maker data survives; the orientation is applied to the pixels first.",
    "plan": [
      [
        2048,
        0.86
      ],
      [
        2048,
        0.72
      ],
      [
        2048,
        0.58
      ],
