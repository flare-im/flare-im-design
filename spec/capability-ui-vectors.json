{
  "$comment": "Shared facts of the plugin host capability components (docs/design/plugin-client-hot-delivery.md 7): FlareCapabilityConsent, FlareDocumentCapture, FlarePaymentConfirmation and the protected media block's address rule. Every kit reads this file in its tests; the rules have the same names in every kit (flareCapability*, flareDocument*, flarePayment*, flareJpegHasExif, flarePluginProtectedMediaSource).",
  "consentDecision": {
    "$comment": "What the viewer's choice answers the engine's consent request with ({granted}); `remember` false asks the host to revoke the grant once the request is done, so the next use asks again.",
    "cases": [
      {
        "decision": "once",
        "granted": true,
        "remember": false
      },
      {
        "decision": "always",
        "granted": true,
        "remember": true
      },
      {
        "decision": "deny",
        "granted": false,
        "remember": false
      }
    ]
  },
  "capabilityLabel": {
    "$comment": "The FlareStrings field that names what the plugin asks to use. An unknown capability gets the generic line, never its raw name.",
    "cases": [
      {
        "capability": "documentCapture",
        "params": {
          "side": "front"
        },
        "key": "capabilityDocumentCapture"
      },
      {
        "capability": "paymentConfirmation",
        "key": "capabilityPaymentConfirmation"
      },
      {
        "capability": "locationOnce",
        "params": {
          "precision": "coarse"
        },
        "key": "capabilityLocationCoarse"
      },
      {
        "capability": "locationOnce",
        "params": {
          "precision": "fine"
        },
        "key": "capabilityLocationFine"
      },
      {
        "capability": "locationOnce",
        "key": "capabilityLocationCoarse"
      },
      {
        "capability": "camera",
        "key": "capabilityCamera"
      },
      {
        "capability": "microphone",
        "key": "capabilityMicrophone"
      },
      {
        "capability": "rtcSession",
        "key": "capabilityRtcSession"
      },
      {
        "capability": "teleport",
        "key": "capabilityGeneric"
      }
    ]
  },
  "consentAllowsAlways": {
    "$comment": "Whether the consent offers \"Always allow\". A one-time location is confirmed every time (design 7.2), so it offers only once and deny.",
    "cases": [
      {
        "capability": "documentCapture",
        "always": true
      },
      {
        "capability": "paymentConfirmation",
        "always": true
      },
      {
        "capability": "locationOnce",
        "always": false
      },
      {
        "capability": "camera",
        "always": true
      }
    ]
  },
  "paymentAmount": {
    "$comment": "The order's amount as the confirmation draws it: the currency's symbol (or the code after the number), the integer part grouped by three with commas, the fraction exactly as the order wrote it. Never parsed as a float. An amount that is not a plain non-negative decimal (at most 18 fraction digits) draws nothing and cannot be confirmed (null).",
