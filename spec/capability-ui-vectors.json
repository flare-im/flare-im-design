  "protectedMediaSource": {
    "$comment": "Which addresses a protected media block draws. The server's owner read answers an absolute https address with a short-lived ?grant=; native kits draw only https and data:image, the Vue kit also blob: (what a web host fetched) and a Tauri asset address. The picture is held in memory only: no disk cache, no share or save menu.",
    "cases": [
      {
        "url": "https://im.example.com/private/realname/owner-materials/a1/m1?grant=abc.def",
        "native": true,
        "web": true
      },
      {
        "url": "http://im.example.com/private/x?grant=abc",
        "native": false,
        "web": false
      },
      {
        "url": "data:image/png;base64,iVBORw0KGgo=",
        "native": true,
        "web": true
      },
      {
        "url": "data:text/html,<b>x</b>",
        "native": false,
        "web": false
      },
      {
        "url": "blob:https://im.example.com/1f2e",
        "native": false,
        "web": true
      },
      {
        "url": "javascript:alert(1)",
        "native": false,
        "web": false
      },
      {
        "url": "file:///tmp/front.jpg",
        "native": false,
        "web": false
      },
      {
        "url": "",
        "native": false,
        "web": false
      }
    ]
  },
  "protectedMediaReason": {
    "$comment": "A protected media read asks the viewer why only when the block declares reasonInput (a console reviewing someone else's material). The owner's own page declares none: one tap reads.",
    "cases": [
      {
        "reasonInput": "reason",
        "asks": true
      },
      {
        "reasonInput": null,
        "asks": false
      }
    ]
  },
  "locationInput": {
    "$comment": "A location input's value (UiLocationValue::fits): the input's precision, a point on the globe, at most 2 decimal places and a whole accuracy of at least 1000 m when coarse, at most 5 places and at least 1 m when fine. Anything else is no value (null); text is how the input shows a fix.",
    "cases": [
      {
        "precision": "coarse",
        "value": {
          "latitude": 31.23,
          "longitude": 121.47,
          "accuracyM": 1000,
          "precision": "coarse"
        },
        "ok": true,
        "text": "31.23°N, 121.47°E"
      },
      {
        "precision": "fine",
        "value": {
          "latitude": -33.86785,
          "longitude": -151.20732,
