      },
      {
        "remainingMs": 60000,
        "text": "01:00",
        "expired": false
      },
      {
        "remainingMs": 0,
        "text": "00:00",
        "expired": true
      },
      {
        "remainingMs": -5000,
        "text": "00:00",
        "expired": true
      }
    ]
  },
  "documentFrame": {
    "$comment": "The viewfinder frame's width over height per side: an ID-1 card (85.6 × 54 mm) for front and back, a 3:4 portrait for holding the document beside the face.",
