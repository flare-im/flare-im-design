  "paymentCountdown": {
    "$comment": "What is left of an order (expiresAtMs minus the server's now): whole seconds rounded up, mm:ss under an hour, h:mm:ss from an hour on. At zero or below the order has expired and confirm is off.",
    "cases": [
      {
        "remainingMs": 125000,
        "text": "02:05",
        "expired": false
      },
      {
        "remainingMs": 3725000,
        "text": "1:02:05",
        "expired": false
