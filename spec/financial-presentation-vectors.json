{
  "card": {
    "available": true,
    "title": "红包",
    "fields": [],
    "actions": [
      {
        "id": "open",
        "label": "查看红包"
      }
    ],
    "presentation": {
      "renderer": "redPacket.card",
      "props": {
        "blessing": "组件接入验收",
        "kind": "normal",
        "status": "refunded",
        "claimedByMe": false
      },
      "actions": {
        "open": "open"
      }
    }
  },
  "payment": {
    "available": true,
    "title": "确认支付",
    "fields": [],
    "actions": [
      {
        "id": "approve",
        "label": "确认授权"
      }
    ],
    "presentation": {
      "renderer": "payment.confirm",
      "props": {
        "amount": "999999999999999999.99",
        "methodLabel": "CNY · cash"
      },
      "actions": {
        "authorize": "approve"
      }
    }
  },
  "composer": {
    "available": true,
    "title": "发红包",
    "fields": [],
    "inputs": [
      {
        "id": "decimalAmount",
        "kind": "text",
        "label": "金额",
        "required": true
      },
      {
        "id": "shareCount",
        "kind": "number",
        "label": "份数",
        "required": true
      },
      {
        "id": "kind",
        "kind": "select",
        "label": "类型",
        "choices": [
          {
            "value": "normal",
            "label": "普通红包"
          },
          {
            "value": "lucky",
            "label": "拼手气红包"
          },
          {
            "value": "exclusive",
            "label": "专属红包"
          }
        ]
      },
      {
        "id": "greeting",
        "kind": "text",
        "label": "祝福语",
        "default": "恭喜发财，大吉大利"
      },
      {
        "id": "designatedUserIds",
        "kind": "members",
        "label": "专属接收人",
        "required": true,
        "min": 1,
        "max": 1,
        "showWhen": {
          "field": "kind",
          "anyOf": [
            "exclusive"
          ]
        }
      }
    ],
    "actions": [
      {
        "id": "prepare",
        "label": "核对并前往钱包授权",
        "form": [
          "kind",
          "decimalAmount",
          "shareCount",
          "greeting",
          "designatedUserIds"
        ]
      }
    ],
    "presentation": {
      "renderer": "redPacket.composer",
      "props": {
        "funding": {
          "currency": "CNY",
          "currencyExponent": 2,
          "label": "CNY · cash"
        },
        "conversationType": "group"
      },
      "actions": {
        "submit": "prepare"
      }
    }
  }
}
