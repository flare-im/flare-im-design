{
  "$comment": "Call record card (FlareCallRecordCard, docs/design/call-plugin-and-feature-toggles.md Kit): the status line, its tone and the one action a viewer sees, as pure rules the Vue, Flutter, SwiftUI and Compose kits run against these cases. Every input is viewer-relative and comes from the host (the call plugin's record card and the viewer's own facts); the card never computes canJoin or canCallBack itself. Change the rules and the cases together.",
  "schemaVersion": 1,
  "rules": {
    "status": "First match wins. ringing: group -> groupRinging; viewerIsInitiator -> waitingAnswer; else incoming. ongoing: single -> inCall; group with joinedCount >= 1 -> groupOngoing, else groupInProgress. ended (a missing endReason reads completed): group -> completed with durationSeconds -> groupEndedDuration, completed without it -> groupEnded, unavailable -> unavailable, failed -> failed, any other reason -> groupEnded. single -> completed -> duration (durationSeconds, 0 when missing); cancelled -> cancelledByYou (initiator) / cancelledByCaller; declined -> declinedByPeer (initiator) / declinedByYou; missed -> noAnswer (initiator) / missed; busy -> peerBusy (initiator) / missedBusy; unavailable -> unavailable; failed -> failed.",
    "tone": "danger for missed (a call the viewer did not pick up); neutral for everything else.",
    "action": "disabled -> none. group and state is not ended and canJoin -> join. single and state is ended and canCallBack -> callBack. Otherwise none. busy keeps the action visible but not actionable (actionEnabled false, with a progress indicator).",
    "duration": "Whole seconds, floored, negative read as 0. Under an hour: mm:ss with both parts two digits. From an hour: h:mm:ss, hours unpadded.",
    "icon": "The kit icon phone for audio, video for video. The icon set has no outgoing / incoming variants, so direction is carried by the copy alone."
  },
  "duration": [
    {
      "seconds": 0,
      "label": "00:00"
    },
